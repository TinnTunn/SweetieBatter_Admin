# Copy to .env.local — Supabase → Project Settings → API.
# The anon / publishable key is public by design (RLS protects writes).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional. The admin is normally opened at <website>/admin/, so photos and
# "Lihat website" resolve against the same domain. Only set this if you open
# the admin on its own domain (e.g. https://sweetiebatter-admin.vercel.app).
# VITE_SITE_URL=https://sweetiebatter.vercel.app/
